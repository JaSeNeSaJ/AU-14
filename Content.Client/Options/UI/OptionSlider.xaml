<Control xmlns="https://spacestation14.io">
    <!-- CrtOptionRow carries the divider the whole width of the row, so the line runs under the
         label too rather than starting at the control. -->
    <PanelContainer StyleClasses="CrtOptionRow">
        <BoxContainer Orientation="Horizontal">
            <!-- The label expands and the slider is a fixed width, so every slider is the same size
                 and sits in the same column no matter how long its label is. A fixed *label* gutter
                 can't do that: anything wider than the gutter pushes its own slider right and
                 shortens it, which is what made the opacity group look ragged. -->
            <Label Name="NameLabel" HorizontalExpand="True" MinWidth="160" VerticalAlignment="Center" />
            <Slider Name="Slider" Access="Public" MinWidth="300" />
            <!-- Butted straight against the track with no margin, so its frame continues the
                 slider's rather than floating beside it. -->
            <PanelContainer StyleClasses="CrtSliderValue">
                <Label Name="ValueLabel" Access="Public" MinWidth="42" Align="Right" VerticalAlignment="Center" />
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
