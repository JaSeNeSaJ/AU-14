<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="640 0">
    <!-- One card per faction, each with its own border and colour, and the button alternating left
         and right down the list. The alternation is doing work rather than decoration: four
         identical rows read as a table you scan past, whereas a zig-zag makes each card its own
         object and forces the eye to stop at each one.

         The button is a segment of the card, not something sitting on it - no separation, no margin,
         and it expands to the card's full height, so it runs edge to edge inside the border and the
         only thing dividing it from the text is a single rule in the faction's own colour.

         MaxWidth on the descriptions is what keeps this window a sensible shape. A RichTextLabel
         wraps to whatever width it is given, but its *desired* width is the whole unwrapped line, so
         without a cap the window widened until every description fitted on one line and the thing
         ended up over 1300px across. Capping it forces the wrap and lets the window settle.

         Colours are deliberately off the CRT palette. The theme's discipline is a single hue, but a
         faction earns an exception - Opfor being red and the xeno-heavy Other being purple says more
         at a glance than any label does. Set in the code-behind so they survive the theme walk. -->
    <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="8">
        <Label Text="{Loc 'cmu-lobby-join-round-prompt'}" StyleClasses="CrtDimText" />

        <!-- Colonists: button left. -->
        <PanelContainer Name="ColonistsCard" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="0" HorizontalExpand="True">
                <Button Name="JoinColonistsButton" Access="Public"
                        Text="{Loc 'lobby-state-ready-button-join-state'}"
                        MinWidth="164" MinHeight="46" VerticalExpand="True" />
                <RichTextLabel Name="JoinColonistsDesc" HorizontalExpand="True"
                               MaxWidth="430" Margin="14 10"
                               StyleClasses="CrtRichText" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <!-- Govfor: button right. -->
        <PanelContainer Name="GovforCard" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="0" HorizontalExpand="True">
                <RichTextLabel Name="JoinGovforDesc" HorizontalExpand="True"
                               MaxWidth="430" Margin="14 10"
                               StyleClasses="CrtRichText" VerticalAlignment="Center" />
                <Button Name="JoinGovforButton" Access="Public"
                        Text="{Loc 'rmc-lobby-join-govfor'}"
                        MinWidth="164" MinHeight="46" VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>

        <!-- Opfor: button left. -->
        <PanelContainer Name="OpforCard" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="0" HorizontalExpand="True">
                <Button Name="JoinOpforButton" Access="Public"
                        Text="{Loc 'rmc-lobby-join-opfor'}"
                        MinWidth="164" MinHeight="46" VerticalExpand="True" />
                <RichTextLabel Name="JoinOpforDesc" HorizontalExpand="True"
                               MaxWidth="430" Margin="14 10"
                               StyleClasses="CrtRichText" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <!-- Other: button right. -->
        <PanelContainer Name="OtherCard" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" SeparationOverride="0" HorizontalExpand="True">
                <RichTextLabel Name="JoinOtherDesc" HorizontalExpand="True"
                               MaxWidth="430" Margin="14 10"
                               StyleClasses="CrtRichText" VerticalAlignment="Center" />
                <Button Name="JoinOtherButton" Access="Public"
                        Text="{Loc 'rmc-lobby-join-other'}"
                        MinWidth="164" MinHeight="46" VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
