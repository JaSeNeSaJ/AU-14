<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="320 0">
    <!-- No inner CrtPanel: the window's own CrtWindow panel already draws a border, and a second
         one inside it reads as a box in a box. The title bar covers the heading, so the content is
         nothing but the four choices. -->
    <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="5">
        <Label Text="{Loc 'cmu-lobby-join-round-prompt'}" StyleClasses="CrtDimText" />
        <GridContainer Columns="2" HorizontalExpand="True" HSeparationOverride="6" VSeparationOverride="4">
            <Button Name="JoinColonistsButton" Access="Public"
                    Text="{Loc 'lobby-state-ready-button-join-state'}"
                    StyleClasses="ButtonBig" MinHeight="28" HorizontalExpand="True" />
            <Button Name="JoinGovforButton" Access="Public"
                    Text="{Loc 'rmc-lobby-join-govfor'}"
                    StyleClasses="ButtonBig" MinHeight="28" HorizontalExpand="True" />
            <Button Name="JoinOpforButton" Access="Public"
                    Text="{Loc 'rmc-lobby-join-opfor'}"
                    StyleClasses="ButtonBig" MinHeight="28" HorizontalExpand="True" />
            <Button Name="JoinOtherButton" Access="Public"
                    Text="{Loc 'rmc-lobby-join-other'}"
                    StyleClasses="ButtonBig" MinHeight="28" HorizontalExpand="True" />
        </GridContainer>
    </BoxContainer>
</DefaultWindow>
