<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <controls:NanoHeading Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}">

        </controls:NanoHeading>
        <!-- Summary on the left; the sprite and the controls that change it are grouped together on
             the right, with prev/next either side of it and Customize beneath. -->
        <BoxContainer Name="Loaded" Orientation="Horizontal"
                      Margin="0 8 0 0"
                      Visible="False">
            <!-- Both columns expand on a fixed ratio rather than sizing to their content. Without
                 this the summary column is as wide as the longest line in it, so the sprite slid
                 left and right as the character's name changed length. The split is roughly the
                 proportion a full-length name ("Alexander Xander Trenton") already needed. -->
            <BoxContainer Orientation="Vertical" VerticalAlignment="Center"
                          HorizontalExpand="True" SizeFlagsStretchRatio="6"
                          SeparationOverride="8" Margin="2 0 12 0">
                <!-- Clipped to one line in code; a longer name is cut off rather than wrapping and
                     pushing the age, job line and toggle down. -->
                <RichTextLabel Name="SummaryName" StyleClasses="CrtCharacterSummary" RectClipContent="True" />
                <RichTextLabel Name="SummaryAge" StyleClasses="CrtCharacterSummary" />
                <Label Name="JobSummary" StyleClasses="CrtHeading" Visible="False"/>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="IgnoreAllegianceButton" ToggleMode="True" Text="{Loc 'lobby-character-preview-ignore-allegiance'}"
                            ToolTip="{Loc 'lobby-character-preview-ignore-allegiance-tooltip'}" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="4"
                          HorizontalAlignment="Center" SeparationOverride="6">
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                    <Button Name="PrevCharButton" Text="&lt;" VerticalAlignment="Center"
                            ToolTip="{Loc 'lobby-character-preview-prev-char-tooltip'}" />
                    <BoxContainer Name="ViewBox" Orientation="Horizontal" VerticalAlignment="Center">

                    </BoxContainer>
                    <Button Name="NextCharButton" Text="&gt;" VerticalAlignment="Center"
                            ToolTip="{Loc 'lobby-character-preview-next-char-tooltip'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="6">
                    <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}" />
                    <Button Name="PatronPerks" Access="Public" Text="{Loc 'rmc-ui-patron-perks'}" Visible="False" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"/>
    </BoxContainer>
</Control>
