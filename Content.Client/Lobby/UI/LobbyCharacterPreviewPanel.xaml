<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <!-- Plain label, not a NanoHeading: NanoHeading draws a bordered panel around the word, and
             nothing else on this screen has a frame any more. -->
        <Label Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}"
               StyleClasses="CrtFieldLabel" />
        <!-- One full-width panel. This was briefly a character block beside a column of round stats,
             which only moved the dead space rather than removing it: players and round time are one
             short line each, so a tall narrow cell wasted most of itself and left a gap nothing could
             fill. They now live inline in ServerInfo's heading row, and the character block takes the
             whole width back. -->
        <BoxContainer Name="Loaded" Orientation="Horizontal"
                      Margin="0 8 0 0"
                      SeparationOverride="2"
                      Visible="False">
            <PanelContainer Name="CharacterBacking" Access="Public" HorizontalExpand="True"
                            RectClipContent="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="12 10">
                    <!-- Prev/next sit either side of the sprite as its own controls, then the summary
                         takes the remaining width. Keeping the arrows adjacent to the thing they
                         change is what stops them reading as loose chrome. -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Button Name="PrevCharButton" Text="&lt;" VerticalAlignment="Center"
                                ToolTip="{Loc 'lobby-character-preview-prev-char-tooltip'}" />
                        <BoxContainer Name="ViewBox" Orientation="Horizontal" VerticalAlignment="Center">

                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                      VerticalAlignment="Center" SeparationOverride="3"
                                      Margin="4 0 4 0" RectClipContent="True">
                            <!-- Clipped to one line in code; a longer name is cut off rather than
                                 wrapping and pushing the age and job line down. -->
                            <RichTextLabel Name="SummaryName" StyleClasses="CrtCharacterSummary" RectClipContent="True" />
                            <RichTextLabel Name="SummaryAge" StyleClasses="CrtCharacterSummary" />
                            <Label Name="JobSummary" StyleClasses="CrtHeading" Visible="False"
                                   Align="Center" HorizontalExpand="True" ClipText="True" />
                        </BoxContainer>
                        <Button Name="NextCharButton" Text="&gt;" VerticalAlignment="Center"
                                ToolTip="{Loc 'lobby-character-preview-next-char-tooltip'}" />
                    </BoxContainer>
                    <!-- The two things you act on, on one row under the thing they act on. -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="2">
                        <Button Name="IgnoreAllegianceButton" ToggleMode="True" HorizontalExpand="True"
                                Text="{Loc 'lobby-character-preview-ignore-allegiance'}"
                                ToolTip="{Loc 'lobby-character-preview-ignore-allegiance-tooltip'}" />
                        <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}" />
                        <Button Name="PatronPerks" Access="Public" Text="{Loc 'rmc-ui-patron-perks'}" Visible="False" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"/>
    </BoxContainer>
</Control>
