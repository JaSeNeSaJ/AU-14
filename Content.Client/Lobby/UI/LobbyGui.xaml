<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:cmu="clr-namespace:Content.Client._CMU14.Interface">
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="10 10 10 10" SeparationOverride="2">
        <SplitContainer State="Auto" ResizeMode="NotResizable" HorizontalExpand="True">
            <!-- LHS Controls -->
            <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Name="TopLeft" Orientation="Vertical">
                        <!-- Left Top Panel -->
                        <!-- Ticked panel so this reads as the same piece of equipment as a VotePopup.
                             It no longer matches the popup's 620 width: with the factions behind
                             JoinRoundWindow there are only four buttons left, and stretching them to
                             a vote popup's width would put back the empty space that move removed. -->
                        <PanelContainer StyleClasses="CrtPanelTicked" HorizontalAlignment="Left" Name="LeftSideTop"
                                        VerticalAlignment="Top">
                            <BoxContainer Orientation="Vertical" SeparationOverride="5" MaxWidth="1040"
                                          MinWidth="{x:Static cmu:CmuPanelMetrics.LobbyActionColumnWidth}">
                                <!-- Ranked, not a grid of equals. Only one of Ready/Join is ever
                                     visible - whichever it is, it is the thing you came here to do,
                                     so it gets the full width and the taller box. Observe sits under
                                     it at a smaller height: a real action, but not the one being
                                     offered. Side by side at identical size they read as a choice
                                     between two equivalent things, which they are not.
                                     The four faction choices moved into JoinRoundWindow - they are
                                     one decision taken once, not four permanent slots. -->
                                <BoxContainer Name="ActionButtons" Orientation="Vertical" HorizontalExpand="True"
                                              SeparationOverride="{x:Static cmu:CmuPanelMetrics.GroupSeparation}">
                                    <!-- The clock, folded. The countdown is the button's own label so
                                         this stays one control, not a panel inside the panel. -->
                                    <Button Name="DockedClockButton" Access="Public"
                                            ToolTip="{Loc 'cmu-lobby-clock-restore-tooltip'}"
                                            HorizontalExpand="True" Visible="False"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.Row}" />
                                    <!-- CrtReadyToggle, not ButtonBig: this control's job is to say
                                         which of two states you are in, and the shared button box
                                         says only that it is pressable. CrtLobbyTheme withholds the
                                         standard CRT button class from anything wearing this. -->
                                    <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                            Text="{Loc 'ui-lobby-ready-up-button'}"
                                            StyleClasses="CrtReadyToggle" HorizontalExpand="True"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.RowTall}" />
                                    <!-- RMC14/AU -->
                                    <Button Name="JoinRoundButton" Access="Public"
                                            Text="{Loc 'cmu-lobby-join-round'}"
                                            StyleClasses="ButtonBig" HorizontalExpand="True"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.Row}"
                                            Visible="False" />
                                    <!-- A rule, not just a gap. Ready/Join and Observe are ranked
                                         rather than equal, and off-theme two stacked buttons of the
                                         same fill read as one control without something between
                                         them. -->
                                    <PanelContainer StyleClasses="CrtDivider" />
                                    <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                        Text="{Loc 'ui-lobby-observe-button'}"
                                                        StyleClasses="ButtonBig" HorizontalExpand="True"
                                                        MinHeight="{x:Static cmu:CmuPanelMetrics.RowCompact}"
                                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                </BoxContainer>

                                <!-- Reference links share the action grid's metrics but sit under a
                                     rule, so Rules doesn't read as another faction choice. -->
                                <PanelContainer StyleClasses="CrtDivider" />
                                <info:LinkBanner Name="LinkBanner" VerticalExpand="false" HorizontalExpand="True" />
                                <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" HorizontalAlignment="Center" />
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Voting Popups -->
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 8" />
                    </BoxContainer>
                    <!-- Vertical Padding-->
                    <Control VerticalExpand="True" />
                    <!-- Left Bot Panel -->
                    <PanelContainer VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                    Margin="0 75" StyleClasses="CrtPanel">
                        <RichTextLabel Name="LobbyMessageLabel" Access="Public" Margin="5" />
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="false" Margin="3 3 3 3" />
                        <PanelContainer StyleClasses="CrtPanel">
                            <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Center" />
                        </PanelContainer>
                    </BoxContainer>
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>
            <!-- Right Panel -->
            <PanelContainer Name="RightSide" Access="Public" StyleClasses="CrtScreenPanel" HorizontalAlignment="Right" VerticalExpand="True"
                            VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <!-- Everything above the chat is one CRT screen: the header row, the server
                     info block and the character block. The effect needs a surface with real
                     size before it reads as a tube - shading only the server-info table left it
                     too small to make out. Chat stays outside deliberately: it is read
                     continuously and updates live, and a roll bar shearing text mid-sentence is
                     obstructive rather than characterful.

                     LobbyCrtBacking is the opaque base. The shader writes opaque, so any
                     transparent region inside the captured subtree comes back as black; the
                     backing both prevents that and is the screen plane the rows sit on.

                     LobbyCrtContent must keep matching LobbyCrt's rect exactly - the render
                     target captures the subtree at its origin, so any offset between the two
                     shows up as the shaded copy sitting a few pixels off its original. Padding
                     therefore goes on the rows inside, never on Content itself. -->
                <Control Name="LobbyCrtScreen" HorizontalExpand="True">
                    <Control Name="LobbyCrtContent" HorizontalExpand="True">
                        <PanelContainer Name="LobbyCrtBacking" HorizontalExpand="True"
                                        VerticalExpand="True" />
                        <!-- The inset lives here, not on RightSide. Padding on the panel leaves the
                             panel's own fill showing as a ring around this content, which reads as a
                             border; padding here moves only the rows, and LobbyCrtBacking still runs
                             edge to edge behind them as the screen plane. -->
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                      Margin="10 8 10 8">
                            <!-- The server name gets its own line. It is operator-configured text of no
                                 bounded length, and sharing the row with the buttons meant a long one
                                 squeezed them - the name expanded and the actions gave up the width.
                                 CrtHeading rather than LabelHeadingBigger: it already resolves to bold
                                 12 off-theme against the old bold 20, and to the terminal heading face
                                 under CRT, so one class covers both. It is also on ApplyLabel's
                                 early-return list, so the theme will not add a second font rule on top
                                 of it and leave two matching at equal specificity.
                                 No HorizontalAlignment here: Left makes the label take its desired
                                 width, and ClipText makes that width zero, which renders nothing at
                                 all. Stretch is what lets ClipText clip against the row instead. -->
                            <Label Name="ServerName" Access="Public" StyleClasses="CrtHeading" VAlign="Center"
                                   HorizontalExpand="True" ClipText="True"
                                   Margin="4 0 8 0" />
                            <controls:HSpacer Spacing="6" />
                            <!-- Action buttons and the collapse arrow. The four buttons each expand, so
                                 they share the line evenly instead of bunching at one end - the row is
                                 theirs now that the server name has its own. The arrow is left at its
                                 natural width: it is an affordance on the panel, not a fifth action, and
                                 stretching it to a quarter of the row would say otherwise. -->
                            <BoxContainer Orientation="Horizontal" MinHeight="{x:Static cmu:CmuPanelMetrics.Header}" Name="HeaderContainer" Access="Public"
                                          SeparationOverride="4">
                                <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                        StyleClasses="ButtonBig" VerticalAlignment="Center" HorizontalExpand="True" />
                                <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonBig"
                                                         VerticalAlignment="Center" HorizontalExpand="True" />
                                <Button Name="OptionsButton" Access="Public" StyleClasses="ButtonBig"
                                        Text="{Loc 'ui-lobby-options-button'}" VerticalAlignment="Center" HorizontalExpand="True" />
                                <Button Name="LeaveButton" Access="Public" StyleClasses="ButtonBig"
                                        Text="{Loc 'ui-lobby-leave-button'}" VerticalAlignment="Center" HorizontalExpand="True" />
                                <TextureButton Name="CollapseButton"
                                               TexturePath="filled_right_arrow.svg.192dpi"
                                               VerticalAlignment="Center"
                                               Margin="6 0 2 0"
                                               Scale="0.5 0.5" />
                            </BoxContainer>
                            <controls:HSpacer Spacing="4" />
                            <!-- Server info: heading and intro text share the top row.
                                 Wrapped for the CRT effect. The margin moved onto the wrapper so ServerInfo
                                 fills it exactly - the render target captures the subtree at its origin, so
                                 any offset between source and overlay shows up as the shaded copy sitting a
                                 few pixels off its original.
                                 ServerInfoBacking exists because ServerInfo is a BoxContainer with no
                                 background: the shader writes opaque, so without something solid underneath
                                 it the transparent gaps between cells would come back as black. It is the
                                 panel colour, so it is invisible against the CrtPanel behind it. -->
                            <Control Name="ServerInfoScreen" HorizontalExpand="True" Margin="0 0 0 3">
                                <Control Name="ServerInfoContent" HorizontalExpand="True">
                                    <PanelContainer Name="ServerInfoBacking" HorizontalExpand="True"
                                                    VerticalExpand="True" />
                                    <!-- Inset, not flush. ServerInfoBacking fills the whole screen plane and
                                         the rows float inside it, so the backdrop is visible as air on all
                                         four sides - that gap is what reads as a screen showing a UI rather
                                         than as cells sitting on the lobby. The margin goes here rather than
                                         on the wrapper: the shaded subtree is now the whole column, so
                                         padding here only moves the rows, never the captured rect. -->
                                    <info:ServerInfo Name="ServerInfo" Access="Public" VerticalExpand="false"
                                           Title="{Loc 'ui-lobby-server-info-block'}"
                                           HorizontalExpand="True" />
                                </Control>
                            </Control>
                            <controls:HSpacer Spacing="5" />
                            <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
                        </BoxContainer>
                    </Control>
                    <cmu:CrtScreenControl Name="LobbyCrt" HorizontalExpand="True"
                                          VerticalExpand="True" />
                </Control>
                    <!-- No negative margins any more: they existed only to cancel CrtPanel's content
                         margins, and RightSide is now a CrtScreenPanel with none to cancel. -->
                    <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                     Margin="10 0 10 8" MinHeight="50" />
                </BoxContainer>
            </PanelContainer>
        </SplitContainer>
        <!-- Takes the collapse arrow's place, so it has to land on the same pixel or the arrow jumps
             as the panel opens and closes. Both are CrtPanels, so their 10/10/8/8 content margins
             cancel; what has to match is the rest. Vertically: no top margin (RightSide starts flush
             with MainContainer) and a 40px row mirroring HeaderContainer, which is what centres the
             arrow at the same height. Horizontally: this panel's 2px right margin stands in for the
             2px right margin the collapse arrow carries inside its own row. -->
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="CrtPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 0 2 0"
                        Visible="False">
            <BoxContainer Orientation="Horizontal" MinHeight="{x:Static cmu:CmuPanelMetrics.Header}">
                <TextureButton Name="ExpandButton"
                            TexturePath="filled_left_arrow.svg.192dpi"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Scale="0.5 0.5"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <!-- The round clock. It used to be the action panel's heading, which put the one thing here
         you are meant to notice without looking at it in the corner of the screen, at heading
         size, next to the buttons.

         At the root rather than inside DefaultState, for two reasons. It has to survive the switch
         into character customization - SwitchState hides whichever state is not showing, and the
         clock going with it meant losing the countdown exactly when a player is busy and most
         likely to lose track of it. And the drag has to range over the whole window, which it
         cannot do from inside a container that is only as big as one column.

         MouseFilter is Ignore so this full-window layer does not swallow clicks meant for the
         lobby underneath; the clock itself sets Stop, because it is the part you grab.

         LobbyState places it - by default clear of the action column and near the top, or wherever
         it was last dropped - and hides it once the round is running, since a clock counting down
         to something that already happened is just another thing on the screen. -->
    <LayoutContainer Name="ClockLayer" Access="Public" MouseFilter="Ignore"
                     HorizontalExpand="True" VerticalExpand="True">
        <cmu:CmuDraggablePanel Name="RoundClock" Access="Public" StyleClasses="CrtPanelTicked">
            <BoxContainer Orientation="Vertical" SeparationOverride="1"
                          Margin="{x:Static cmu:CmuPanelMetrics.ContentPadding}">
                <!-- Fold control on the caption line, not over the body: the body is the drag handle. -->
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Name="ClockCaption" Access="Public" Align="Center"
                           StyleClasses="CrtDimText" HorizontalExpand="True" />
                    <!-- CrtLobbyTheme never reaches this subtree (it runs on MainContainer only),
                         so CmuIconButton colours itself. Arrow points at where the clock folds to. -->
                    <cmu:CmuIconButton Name="ClockMinimizeButton" Access="Public"
                                       TexturePath="/Textures/Interface/Default/filled_left_arrow.svg.192dpi.png"
                                       ToolTip="{Loc 'cmu-lobby-clock-minimize-tooltip'}" />
                </BoxContainer>
                <Label Name="StartTime" Access="Public" Align="Center"
                       StyleClasses="CrtClock" MinWidth="190" />
                <Label Name="LobbyStatusLine" Access="Public" Align="Center"
                       StyleClasses="CrtDimText" Visible="False" />
            </BoxContainer>
        </cmu:CmuDraggablePanel>
    </LayoutContainer>
    <BoxContainer Name="BalanceRatingContainer"
                  Access="Public"
                  Orientation="Vertical"
                  SeparationOverride="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  MouseFilter="Ignore" />
</lobbyUi:LobbyGui>
